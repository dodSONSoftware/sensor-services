{
  "name": "sensor-services",
  "version": "4.12.5",
  "description": "A RESTful web service connecting to the sensor net and the observability stack.",
  "author": "dodson labs",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp ./src/config.yml ./dist/",
    "start": "node ./dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "blt": "npm run build && npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "ip": "^1.1.8",
    "js-yaml": "^4.2.0",
    "mqtt": "^5.14.1",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/ip": "^1.1.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.13",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "volta": {
    "node": "22.22.0",
    "npm": "10.9.4"
  }
}
