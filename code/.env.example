# Sensor Services — deployment environment template.
#
# Copy to .env (git-ignored) next to docker-compose.yml and fill in real
# values. Docker Compose substitutes ${VAR} references in docker-compose.yml
# from this file automatically.

# Token that gates POST /restart-service (graceful self-restart). The endpoint
# is fail-closed: an unset or invalid value leaves it disabled (503) and the
# service runs normally. The value must be 32+ alphanumeric characters and is
# never written to config.yml (which /api/read-config would expose) nor to any
# log line. Generate one with:
#
#   openssl rand -hex 32
#
RESTART_SERVICE_TOKEN=
